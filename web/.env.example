# Copie para web/.env.local (nunca vai para o Git).
# String de conexão do Neon (painel > Connect > pooled). Pode colar como vem; o app trata o channel_binding.
DATABASE_URL=postgresql://usuario:senha@host-pooler.sa-east-1.aws.neon.tech/rodada?sslmode=require
# Endereço público do app (usado nos links de acesso gerados pelo terminal).
APP_URL=http://localhost:3000
# Só para teste sem e-mail em produção: mostra o link de acesso na tela de entrada. Nunca deixar ligado com acesso aberto.
# LINK_NA_TELA=1
